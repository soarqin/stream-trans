+// Private fixed-version C bridge used only by StreamTrans's embedded server.
+extern "C" LLAMA_API int32_t streamtrans_llama_gpu_layers(
+        const llama_model * model, ggml_backend_dev_t device, uint32_t * total) {
+    if (!model || !device || !total) { return -1; }
+    const int32_t layers = llama_model_n_layer(model);
+    *total = layers + 1;
+    int32_t count = model->dev_output() == device ? 1 : 0;
+    for (int32_t i = 0; i < layers; ++i) {
+        count += model->dev_layer(i) == device ? 1 : 0;
+    }
+    return count;
+}
